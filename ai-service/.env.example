AI_SERVICE_KEY=
LLM_PROVIDER=groq
LLM_MODEL=openai/gpt-oss-20b
GROQ_API_KEY=
# optional: LLM_TIMEOUT_SECONDS=30
# optional: LLM_MAX_ATTEMPTS=2
# optional: LLM_REASONING_EFFORT=medium   (low | medium | high; higher is slower but more thorough)
# optional: EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# optional: MATCH_PARTIAL_THRESHOLD=0.5   (similarity needed to suggest a partial match)
